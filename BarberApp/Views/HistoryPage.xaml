<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:BarberApp.ViewModels"
             xmlns:models="clr-namespace:BarberApp.Models"
             x:Class="BarberApp.Views.HistoryPage"
             Title="История записей"
             BackgroundColor="#F9FAFB">

    <ContentPage.BindingContext>
        <vm:HistoryViewModel />
    </ContentPage.BindingContext>

    <!-- Pull to Refresh -->
    <RefreshView IsRefreshing="{Binding IsRefreshing}" 
                 Command="{Binding RefreshCommand}"
                 RefreshColor="#6B46C1">

        <CollectionView ItemsSource="{Binding Appointments}"
                        Margin="0"
                        BackgroundColor="Transparent">

            <!-- Empty State -->
            <CollectionView.EmptyView>
                <VerticalStackLayout HorizontalOptions="Center" 
                                     VerticalOptions="Center"
                                     Padding="40"
                                     Spacing="16">
                    <Label Text="📅" 
                           FontSize="64" 
                           HorizontalTextAlignment="Center"/>
                    <Label Text="{Binding EmptyMessage}"
                           FontSize="16"
                           TextColor="#6B7280"
                           HorizontalTextAlignment="Center"
                           LineBreakMode="WordWrap"/>
                </VerticalStackLayout>
            </CollectionView.EmptyView>

            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" ItemSpacing="12"/>
            </CollectionView.ItemsLayout>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:AppointmentItem">
                    <Frame BackgroundColor="White"
                           CornerRadius="16"
                           Padding="0"
                           Margin="16,8,16,8"
                           BorderColor="#E5E7EB"
                           HasShadow="True">

                        <VerticalStackLayout Padding="16" Spacing="12">

                            <!-- Заголовок: Дата и статус -->
                            <Grid ColumnDefinitions="*,Auto">
                                <VerticalStackLayout Grid.Column="0">
                                    <Label Text="{Binding Date, StringFormat='{0:dd MMMM yyyy}'}"
                                           FontSize="16"
                                           FontAttributes="Bold"
                                           TextColor="#111827"/>
                                    <Label Text="{Binding Date, StringFormat='{0:HH:mm}'}"
                                           FontSize="14"
                                           TextColor="#6B46C1"
                                           FontAttributes="Bold"/>
                                </VerticalStackLayout>

                           
                                <!-- Статус -->
                                <Frame Grid.Column="1"
       BackgroundColor="{Binding StatusBgColor}"
       Padding="8,4"
       CornerRadius="8"
       HasShadow="False">
                                    <Label Text="{Binding Status}"
           TextColor="{Binding StatusTextColor}"
           FontSize="12"
           FontAttributes="Bold"/>
                                </Frame>
                            </Grid>

                            <!-- Разделитель -->
                            <BoxView HeightRequest="1" 
                                     BackgroundColor="#F3F4F6"
                                     Margin="0,4"/>

                            <!-- Мастер -->
                            <HorizontalStackLayout Spacing="8">
                                <Label Text="👨‍🔧" FontSize="16"/>
                                <Label Text="{Binding MasterName}"
                                       FontSize="14"
                                       TextColor="#374151"
                                       VerticalTextAlignment="Center"/>
                            </HorizontalStackLayout>

                            <!-- Салон -->
                            <HorizontalStackLayout Spacing="8">
                                <Label Text="📍" FontSize="16"/>
                                <Label Text="{Binding SalonName}"
                                       FontSize="14"
                                       TextColor="#374151"
                                       VerticalTextAlignment="Center"/>
                            </HorizontalStackLayout>

                            <!-- Услуга -->
                            <HorizontalStackLayout Spacing="8">
                                <Label Text="✂️" FontSize="16"/>
                                <Label Text="{Binding ServiceName}"
                                       FontSize="14"
                                       TextColor="#374151"
                                       VerticalTextAlignment="Center"/>
                            </HorizontalStackLayout>
                            <!-- Цена -->
                            <HorizontalStackLayout Spacing="8">
                                <Label Text="💵" FontSize="16"/>
                                <Label Text="{Binding Price, StringFormat='{0:N0} ₽'}" 
           FontSize="15" FontAttributes="Bold" TextColor="#059669"/>
                            </HorizontalStackLayout>

                        </VerticalStackLayout>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </RefreshView>
</ContentPage>