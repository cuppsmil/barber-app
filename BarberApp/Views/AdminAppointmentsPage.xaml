<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:BarberApp.ViewModels"
             xmlns:models="clr-namespace:BarberApp.Models"
             x:Class="BarberApp.Views.AdminAppointmentsPage"
             Title="Записи салона"
             BackgroundColor="#F9FAFB"
             NavigationPage.HasBackButton="True">

    <ContentPage.BindingContext>
        <vm:AdminAppointmentsViewModel />
    </ContentPage.BindingContext>

    <CollectionView ItemsSource="{Binding Items}" Margin="16">
        <CollectionView.EmptyView>
            <Label Text="Нет записей" TextColor="Gray" HorizontalTextAlignment="Center" HeightRequest="200"/>
        </CollectionView.EmptyView>

        <CollectionView.ItemTemplate>
            <DataTemplate x:DataType="models:AppointmentItem">
                <Frame BackgroundColor="White" Margin="0,0,0,12" Padding="16" CornerRadius="12" BorderColor="#E5E7EB" HasShadow="True">
                    <VerticalStackLayout Spacing="10">
                        <!-- Дата -->
                        <Label Text="{Binding Date, StringFormat='📅 {0:dd.MM.yyyy HH:mm}'}" FontAttributes="Bold" FontSize="16" TextColor="#6B46C1"/>
                        <BoxView HeightRequest="1" BackgroundColor="#F3F4F6"/>

                        <!-- Клиент -->
                        <Label Text="Клиент" FontSize="12" TextColor="#6B7280"/>
                        <Label Text="{Binding MasterName}" FontSize="15" FontAttributes="Bold" TextColor="#111827"/>

                        <!-- Мастер -->
                        <Label Text="Мастер" FontSize="12" TextColor="#6B7280" Margin="0,6,0,0"/>
                        <Label Text="{Binding SalonName}" FontSize="15" TextColor="#374151"/>

                        <!-- Услуга -->
                        <Label Text="Услуга" FontSize="12" TextColor="#6B7280" Margin="0,6,0,0"/>
                        <Label Text="{Binding ServiceName}" FontSize="15" TextColor="#374151"/>

                        <!-- ✅ ЦЕНА -->
                        <Label Text="{Binding Price, StringFormat='💰 Цена: {0:N0} ₽'}" 
                               FontSize="16" 
                               FontAttributes="Bold" 
                               TextColor="#10B981"
                               Margin="0,10,0,0"/>
                    </VerticalStackLayout>
                </Frame>
            </DataTemplate>
        </CollectionView.ItemTemplate>
    </CollectionView>
</ContentPage>