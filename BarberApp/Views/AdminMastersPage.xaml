<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:BarberApp.ViewModels"
             xmlns:models="clr-namespace:BarberApp.Models"
             x:Class="BarberApp.Views.AdminMastersPage"
             Title="Мастера"
             BackgroundColor="#F9FAFB">

    <ContentPage.BindingContext>
        <vm:AdminMastersViewModel />
    </ContentPage.BindingContext>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Frame Grid.Row="0" BackgroundColor="White" Padding="16" HasShadow="True">
            <Grid ColumnDefinitions="*,Auto">
                <Label Grid.Column="0" Text="Мастера салона" FontSize="20" FontAttributes="Bold" VerticalTextAlignment="Center"/>
                <Button Grid.Column="1" Text="Назад" BackgroundColor="#6B46C1" TextColor="White" CornerRadius="8" Padding="16,8" Command="{Binding GoBackCommand}"/>
            </Grid>
        </Frame>

        <CollectionView Grid.Row="1" ItemsSource="{Binding Masters}" Margin="16">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Master">
                    <Frame BackgroundColor="White" Margin="0,0,0,12" Padding="16" CornerRadius="12" BorderColor="#E5E7EB" HasShadow="True">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <Border Grid.Column="0" WidthRequest="60" HeightRequest="60" StrokeShape="RoundRectangle 30" StrokeThickness="2" Stroke="#6B46C1" BackgroundColor="#E9D5FF">
                                <Label Text="{Binding Fio}" TextColor="#6B46C1" FontAttributes="Bold" FontSize="20" HorizontalTextAlignment="Center" VerticalTextAlignment="Center"/>
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Margin="16,0,0,0" VerticalOptions="Center">
                                <Label Text="{Binding Fio}" FontSize="18" FontAttributes="Bold" TextColor="#111827"/>
                                <Label Text="{Binding Grade}" FontSize="14" TextColor="#6B7280"/>
                                <Label Text="{Binding Phone}" FontSize="13" TextColor="#374151" Margin="0,4,0,0"/>
                            </VerticalStackLayout>
                            <Label Grid.Column="2" Text="Специалист" FontSize="12" TextColor="#9CA3AF" VerticalOptions="Center" HorizontalTextAlignment="Center"/>
                        </Grid>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>