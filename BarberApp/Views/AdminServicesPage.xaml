<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:BarberApp.ViewModels"
             xmlns:models="clr-namespace:BarberApp.Models"
             x:Class="BarberApp.Views.AdminServicesPage"
             Title="Услуги"
             BackgroundColor="#F9FAFB">

    <ContentPage.BindingContext>
        <vm:AdminServicesViewModel />
    </ContentPage.BindingContext>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Frame Grid.Row="0" BackgroundColor="White" Padding="16" HasShadow="True">
            <Grid ColumnDefinitions="*,Auto">
                <Label Grid.Column="0" Text="Услуги салона" FontSize="20" FontAttributes="Bold" VerticalTextAlignment="Center"/>
                <Button Grid.Column="1" Text="Назад" BackgroundColor="#6B46C1" TextColor="White" CornerRadius="8" Padding="16,8" Command="{Binding GoBackCommand}"/>
            </Grid>
        </Frame>

        <CollectionView Grid.Row="1" ItemsSource="{Binding Services}" Margin="16">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:ServiceItem">
                    <Frame BackgroundColor="White" Margin="0,0,0,12" Padding="16" CornerRadius="12" BorderColor="#E5E7EB" HasShadow="True">
                        <Grid ColumnDefinitions="*,Auto">
                            <VerticalStackLayout Grid.Column="0">
                                <Label Text="{Binding Name}" FontSize="18" FontAttributes="Bold" TextColor="#111827"/>
                                <Label Text="{Binding Description}" FontSize="14" TextColor="#6B7280" Margin="0,4,0,0"/>
                            </VerticalStackLayout>
                            <Frame Grid.Column="1" BackgroundColor="#E9D5FF" Padding="12,8" CornerRadius="8" HasShadow="False">
                                <Label Text="{Binding Duration, StringFormat='{0} мин'}" TextColor="#6B46C1" FontAttributes="Bold" FontSize="14" VerticalTextAlignment="Center"/>
                            </Frame>
                        </Grid>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>