<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BarberApp.Views.LoginPage"
             Title="BarberApp - Вход"
             BackgroundColor="White">

    <ScrollView>
        <VerticalStackLayout Padding="30" Spacing="20" VerticalOptions="Center">

            <Label Text="🪒" FontSize="64" HorizontalOptions="Center"/>
            <Label Text="BarberApp" 
                   FontSize="32" 
                   FontAttributes="Bold" 
                   HorizontalOptions="Center"
                   TextColor="Purple"/>

            <BoxView HeightRequest="1" Color="Gray" Margin="0,10"/>

            <ActivityIndicator x:Name="LoadingIndicator"
                              IsRunning="False"
                              IsVisible="False"
                              Color="Purple"
                              HorizontalOptions="Center"/>

            <Label x:Name="ErrorLabel"
                  TextColor="Red"
                  HorizontalOptions="Center"
                  IsVisible="False"/>

            <!-- 🔹 РЕЖИМ ВХОДА -->
            <VerticalStackLayout x:Name="LoginMode" Spacing="15">
                <Label Text="Вход" FontSize="24" FontAttributes="Bold" HorizontalOptions="Center"/>

                <Entry x:Name="LoginEntry" 
                       Placeholder="Логин"
                       HeightRequest="50"
                       BackgroundColor="#F9FAFB"/>

                <Entry x:Name="PasswordEntry" 
                       Placeholder="Пароль"
                       IsPassword="True"
                       HeightRequest="50"
                       BackgroundColor="#F9FAFB"/>

                <Button Text="Войти" 
                        x:Name="LoginButton"
                        BackgroundColor="Purple"
                        TextColor="White"
                        CornerRadius="12"
                        HeightRequest="50"
                        Clicked="OnLoginClicked"/>

                <Label Text="Нет аккаунта? Зарегистрироваться"
                      TextColor="Purple"
                      TextDecorations="Underline"
                      HorizontalOptions="Center"
                      Margin="0,10,0,0">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnToggleModeClicked"/>
                    </Label.GestureRecognizers>
                </Label>
            </VerticalStackLayout>

            <!-- 🔹 РЕЖИМ РЕГИСТРАЦИИ -->
            <VerticalStackLayout x:Name="RegisterMode" Spacing="15" IsVisible="False">
                <Label Text="Регистрация" FontSize="24" FontAttributes="Bold" HorizontalOptions="Center"/>

                <Entry x:Name="NameEntry" 
                       Placeholder="Имя"
                       HeightRequest="50"
                       BackgroundColor="#F9FAFB"/>

                <Entry x:Name="PhoneEntry" 
                       Placeholder="Телефон"
                       Keyboard="Telephone"
                       HeightRequest="50"
                       BackgroundColor="#F9FAFB"/>

                <Entry x:Name="RegisterLoginEntry" 
                       Placeholder="Логин"
                       HeightRequest="50"
                       BackgroundColor="#F9FAFB"/>

                <Entry x:Name="RegisterPasswordEntry" 
                       Placeholder="Пароль"
                       IsPassword="True"
                       HeightRequest="50"
                       BackgroundColor="#F9FAFB"/>

                <Entry x:Name="ConfirmPasswordEntry" 
                       Placeholder="Подтвердите пароль"
                       IsPassword="True"
                       HeightRequest="50"
                       BackgroundColor="#F9FAFB"/>

                <Button Text="Зарегистрироваться" 
                        x:Name="RegisterButton"
                        BackgroundColor="Purple"
                        TextColor="White"
                        CornerRadius="12"
                        HeightRequest="50"
                        Clicked="OnRegisterClicked"/>

                <Label Text="Уже есть аккаунт? Войти"
                      TextColor="Purple"
                      TextDecorations="Underline"
                      HorizontalOptions="Center"
                      Margin="0,10,0,0">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnToggleModeClicked"/>
                    </Label.GestureRecognizers>
                </Label>
            </VerticalStackLayout>

            <!-- ✅ КНОПКА АДМИНА — ВЫНЕСЕНА ОТДЕЛЬНО (всегда видна) -->
            <BoxView HeightRequest="1" Color="#E5E7EB" Margin="0,20"/>

            <Button Text="👑 Войти как Администратор" 
                    BackgroundColor="#1F2937"
                    TextColor="White"
                    CornerRadius="12"
                    HeightRequest="50"
                    Clicked="OnAdminLoginClicked"/>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>