<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BarberApp.Views.LoginPage"
             Title="BarberApp - Вход"
             BackgroundColor="White">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="12" VerticalOptions="Center">

            <Label Text="BarberApp" 
                   FontSize="32" 
                   FontAttributes="Bold" 
                   HorizontalOptions="Center"
                   TextColor="Purple"/>

            <BoxView HeightRequest="1" Color="Gray" Margin="0,10"/>

            <ActivityIndicator x:Name="LoadingIndicator"
                              IsRunning="False" 
                              IsVisible="False"
                              Color="Purple" 
                              HorizontalOptions="Center"/>

            <Label x:Name="ErrorLabel"
                  TextColor="Red" 
                  FontSize="14"
                  HorizontalOptions="Center" 
                  IsVisible="False"
                  HorizontalTextAlignment="Center"/>

            <!-- 🔹 РЕЖИМ ВХОДА -->
            <VerticalStackLayout x:Name="LoginMode" Spacing="8">
                <Label Text="Вход" FontSize="24" FontAttributes="Bold" HorizontalOptions="Center"/>

                <Entry x:Name="LoginEntry" 
                       Placeholder="Логин" 
                       HeightRequest="50"
                       BackgroundColor="#F9FAFB"/>

                <Entry x:Name="PasswordEntry" 
                       Placeholder="Пароль" 
                       IsPassword="True"
                       HeightRequest="50"
                       BackgroundColor="#F9FAFB"/>

                <Button Text="Войти" 
                        x:Name="LoginButton"
                        BackgroundColor="Purple" 
                        TextColor="White"
                        CornerRadius="12" 
                        HeightRequest="50"
                        Clicked="OnLoginClicked"/>

                <Label Text="Нет аккаунта? Зарегистрироваться"
                      TextColor="Purple" 
                      TextDecorations="Underline"
                      HorizontalOptions="Center" 
                      Margin="0,10,0,0">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnToggleModeClicked"/>
                    </Label.GestureRecognizers>
                </Label>
            </VerticalStackLayout>

            <!-- 🔹 РЕЖИМ РЕГИСТРАЦИИ -->
            <VerticalStackLayout x:Name="RegisterMode" Spacing="4" IsVisible="False">
                <Label Text="Регистрация" 
                       FontSize="24" 
                       FontAttributes="Bold" 
                       HorizontalOptions="Center" 
                       Margin="0,10,0,0"/>

                <!-- Имя -->
                <Entry x:Name="NameEntry"
                       Placeholder="Имя *" 
                       HeightRequest="50" 
                       BackgroundColor="#F9FAFB"/>
                <Label x:Name="NameErrorLabel" 
                       TextColor="Red" 
                       FontSize="12" 
                       Margin="4,0,0,0"
                       IsVisible="False"/>

                <!-- Телефон -->
                <Entry x:Name="PhoneEntry"
                       Placeholder="Телефон *" 
                       Keyboard="Telephone" 
                       HeightRequest="50" 
                       BackgroundColor="#F9FAFB"/>
                <Label x:Name="PhoneErrorLabel" 
                       TextColor="Red" 
                       FontSize="12" 
                       Margin="4,0,0,0"
                       IsVisible="False"/>
                <Label Text="Формат: +7 (999) 123-45-67" 
                       TextColor="Gray" 
                       FontSize="11" 
                       Margin="4,0,0,0"/>

                <!-- Логин -->
                <Entry x:Name="RegisterLoginEntry"
                       Placeholder="Логин *" 
                       HeightRequest="50" 
                       BackgroundColor="#F9FAFB"/>
                <Label x:Name="LoginErrorLabel" 
                       TextColor="Red" 
                       FontSize="12" 
                       Margin="4,0,0,0"
                       IsVisible="False"/>
                <Label Text="Только латиница, цифры и _ (3-20 символов)" 
                       TextColor="Gray" 
                       FontSize="11" 
                       Margin="4,0,0,0"/>

                <!-- Пароль -->
                <Entry x:Name="RegisterPasswordEntry"
                       Placeholder="Пароль *" 
                       IsPassword="True" 
                       HeightRequest="50" 
                       BackgroundColor="#F9FAFB"/>
                <Label x:Name="PasswordErrorLabel" 
                       TextColor="Red" 
                       FontSize="12" 
                       Margin="4,0,0,0"
                       IsVisible="False"/>
                <Label Text="Мин. 8 символов: заглавные, строчные, цифры" 
                       TextColor="Gray" 
                       FontSize="11" 
                       Margin="4,0,0,0"/>

                <!-- Подтверждение пароля -->
                <Entry x:Name="ConfirmPasswordEntry"
                       Placeholder="Повторите пароль *" 
                       IsPassword="True" 
                       HeightRequest="50" 
                       BackgroundColor="#F9FAFB"/>
                <Label x:Name="ConfirmPasswordErrorLabel" 
                       TextColor="Red" 
                       FontSize="12" 
                       Margin="4,0,0,0"
                       IsVisible="False"/>

                <!-- ✅ КНОПКА С Clicked -->
                <Button Text="Зарегистрироваться" 
                        x:Name="RegisterButton"
                        BackgroundColor="Purple" 
                        TextColor="White"
                        CornerRadius="12" 
                        HeightRequest="50" 
                        Margin="0,12,0,0"
                        Clicked="OnRegisterClicked"/>

                <Label Text="Уже есть аккаунт? Войти"
                      TextColor="Purple" 
                      TextDecorations="Underline"
                      HorizontalOptions="Center" 
                      Margin="0,10,0,0">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnToggleModeClicked"/>
                    </Label.GestureRecognizers>
                </Label>
            </VerticalStackLayout>

            <!-- 🔹 КНОПКА АДМИНА -->
            <BoxView HeightRequest="1" Color="#E5E7EB" Margin="0,20"/>

            <Button Text="Войти как Администратор" 
                    BackgroundColor="#1F2937" 
                    TextColor="White"
                    CornerRadius="12" 
                    HeightRequest="50"
                    Clicked="OnAdminLoginClicked"/>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>